model OpenItem {
  id                       String   @id @default(cuid())
  openItemNumber           String   @unique
  openItemType             String
  status                   String
  accountType              String
  accountId                String?
  subsidiaryId             String?
  transactionCurrencyId    String?
  localCurrencyId          String?
  functionalCurrencyId     String?
  groupCurrencyId          String?
  sourceTransactionType    String?
  sourceTransactionId      String?
  sourceTransactionLineId  String?
  sourceNumber             String?
  counterpartyType         String?
  counterpartyId           String?
  documentDate             DateTime?
  postingDate              DateTime?
  dueDate                  DateTime?
  originalTransactionAmount Decimal @db.Decimal(18, 2)
  originalLocalAmount      Decimal? @db.Decimal(18, 2)
  originalFunctionalAmount Decimal? @db.Decimal(18, 2)
  originalGroupAmount      Decimal? @db.Decimal(18, 2)
  openItemEligible         Boolean  @default(true)
  isOpen                   Boolean  @default(true)
